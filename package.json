{
  "name": "@cloakui/responsive",
  "version": "0.0.1",
  "description": "Simple framework for generating responsive CSS styles from JS.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": {
      "require": "./dist/*.js",
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "build": "npm run build-ts",
    "build-ts": "tsc -p tsconfig.json",
    "clean": "rm -rf .turbo && rm -rf dist",
    "clean:modules": "rm -rf node_modules",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloak-labs/cloakui-responsive.git"
  },
  "keywords": [
    "cloakui",
    "responsive",
    "responsive ui",
    "responsive design",
    "responsive css",
    "responsive styles",
    "dynamic responsive styles",
    "dynamic responsive css"
  ],
  "author": "Kaelan Smith",
  "license": "LGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/cloak-labs/cloakui-responsive/issues"
  },
  "homepage": "https://github.com/cloak-labs/cloakui-responsive#readme",
  "devDependencies": {
    "@types/node": "^18.19.130",
    "typescript": "7.0.2",
    "oxfmt": "0.71.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
